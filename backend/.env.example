# MARG Production Environment Configuration Example

# Express Backend Service Port & Environment
PORT=10000
NODE_ENV=production

# Supabase PostgreSQL Database Connection String
# Example: postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.tkckyjyjuxtxakknetdx:Vineet1233@@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true


# Vercel Frontend Deployment URL (For production CORS authorization)
# Example: https://marg-rail-app.vercel.app
FRONTEND_URL=https://marg-rail-app-gmj3.vercel.app/

# Render Python OR-Tools Service URL
# Example: https://marg-python-optimizer.onrender.com or internal http://marg-python-optimizer:5001
PYTHON_SERVICE_URL=http://127.0.0.1:5001

# Supabase Storage Bucket & API Credentials
# Get credentials from Supabase Dashboard -> Project Settings -> API & Storage
SUPABASE_URL=https://tkckyjyjuxtxakknetdx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_dG7KrXpl22bHtb9-sSJ_ug_oDkB0AXG
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=work-evidence

# Groq AI API Configuration (Backend Only - NEVER expose to frontend)
# Get your API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
MARG_AGENT_MAX_ITERATIONS=10
